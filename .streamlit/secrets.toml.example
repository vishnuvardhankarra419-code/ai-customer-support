# Streamlit Secrets Template — copy this to .streamlit/secrets.toml and fill in your values.
# On Streamlit Community Cloud: paste these values in Advanced Settings -> Secrets.

[general]
API_BASE_URL = "http://localhost:8080/api"
OPENAI_API_KEY = "sk-your-openai-api-key-here"
OPENAI_MODEL = "gpt-4o"
OPENAI_BASE_URL = "https://api.openai.com"
